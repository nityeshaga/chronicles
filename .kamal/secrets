# Secrets referenced by config/deploy.yml (registry/password, env/secret, builder/secrets).
# This file is a TEMPLATE and is safe to commit: it only reads from ENV / a password
# manager / a local file. NEVER paste raw credentials here or into config/deploy.yml.

# --- DigitalOcean Container Registry ---------------------------------------------
# DO uses a single API token (or registry-scoped token) as BOTH docker username and
# password. Export it in your shell before running kamal:
#     export DO_REGISTRY_TOKEN=dop_v1_xxxxxxxx
# (`doctl registry login` logs in your LOCAL docker; Kamal still needs these to log
#  the droplet into the registry so it can pull the image.)
KAMAL_REGISTRY_PASSWORD=$(cat ~/.config/digitalocean-token)

# --- Rails ------------------------------------------------------------------------
# Read straight from the uncommitted master key file. Never check config/master.key in.
RAILS_MASTER_KEY=$(cat config/master.key)
