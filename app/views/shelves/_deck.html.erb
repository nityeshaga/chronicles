<%# locals: (ship:) %>
<%# Three stacked cards; the top one carries the ship, and the whole stack opens it. %>
<a class="deck rise k-<%= ship.kind %>" id="<%= dom_id ship %>" href="<%= ship.check_it_out_url %>">
  <div class="card"></div><div class="card"></div>
  <div class="card">
    <h4><%= ship.title %></h4>
    <% if ship.blurb.present? %><p><%= ship.blurb %></p><% end %>
    <div class="foot"><span><%= ship.explorable? ? "Deck" : "Comic" %></span><span><%= ship.shipped_on.strftime("%-d %b %Y") %></span></div>
  </div>
</a>
