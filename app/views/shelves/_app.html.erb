<%# locals: (ship:) %>
<%# One app on the shelf: its preview as the art, then the title, the blurb and the line from the log. %>
<a class="mach rise k-<%= ship.kind %>" id="<%= dom_id ship %>" href="<%= ship.check_it_out_url %>">
  <div class="art">
    <% case ship.media_kind
       when :video %>
      <video muted loop playsinline preload="none" data-controller="lazy-video" data-src="<%= ship.preview_path %>"<% if ship.poster_path %> poster="<%= ship.poster_path %>"<% end %>></video>
    <% when :image %>
      <img src="<%= ship.preview_path %>" alt="">
    <% when :cover %>
      <img src="<%= ship.post.feature_image_url %>" alt="">
    <% else %>
      <span class="no">No. <%= format "%03d", ship.number %></span>
    <% end %>
  </div>
  <div class="meta">
    <h4><%= ship.title %></h4>
    <% if ship.blurb.present? %><p><%= ship.blurb %></p><% end %>
    <span class="mono">Shipped <%= ship.shipped_on.strftime("%-d %b %Y") %> · No. <%= format "%03d", ship.number %></span>
  </div>
</a>
