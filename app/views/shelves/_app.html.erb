<%# locals: (ship:) %>
<%# One app on the shelf: its preview as the art, then the title, the blurb and the line from the log. %>
<a class="mach rise k-<%= ship.kind %>" id="<%= dom_id ship %>" href="<%= ship.check_it_out_url %>">
  <div class="art">
    <% case ship.media_kind
       when :video %>
      <video autoplay muted loop playsinline<% if ship.poster_path %> poster="<%= ship.poster_path %>"<% end %> src="<%= ship.preview_path %>"></video>
    <% when :image %>
      <img src="<%= ship.preview_path %>" alt="">
    <% when :cover %>
      <img src="<%= ship.post.feature_image_url %>" alt="">
    <% else %>
      <span class="no">№ <%= format "%03d", ship.number %></span>
    <% end %>
  </div>
  <div class="meta">
    <h4><%= ship.title %></h4>
    <% if ship.blurb.present? %><p><%= ship.blurb %></p><% end %>
    <span class="mono">Shipped <%= ship.shipped_on.strftime("%-d %b %Y") %> · № <%= format "%03d", ship.number %></span>
  </div>
</a>
