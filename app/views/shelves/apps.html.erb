<% content_for :body_class, "shelf-template" %>
<% content_for :meta_title, "Apps — #{Setting.current.author_name}" %>

<section class="ph"><div class="wrap">
  <div class="kick">The catalogue · <%= pluralize @apps.size, "app" %> in print</div>
  <h1>Real tools. Free. Kept in print.</h1>
  <p>Built by me and Luo, run on my own box, and maintained the way a book stays in print. No payments, no upsells.</p>
</div></section>

<section class="shelf"><div class="wrap">
  <div class="machines">
    <%= render partial: "shelves/app", collection: @apps, as: :ship %>
  </div>

  <%# Skills and parts: the tools that live in a repository, each pointing back at its log entry. %>
  <div class="shelf-head" id="tools"><h2>Skills &amp; parts.</h2><span class="mono">Open source · on GitHub</span></div>
  <div class="essay-list">
    <% @tools.each do |ship| %>
      <a class="rise" href="<%= root_path %>#<%= dom_id ship %>"><span class="mono">No. <%= format "%03d", ship.number %></span><div><h4><%= ship.title %></h4><% if ship.blurb.present? %><p><%= ship.blurb %></p><% end %></div></a>
    <% end %>
  </div>
</div></section>

<%= render "ships/subscribe" %>
