<%# One note: the popover a pin opens, and the row an orphan shows as. The selector on
    the element is what the controller pins by — the DOM attribute is the state. %>
<li id="<%= dom_id note %>" class="redpen-note <%= "redpen-note--resolved" if note.resolved? %>"
    data-redpen-target="note" data-note-selector="<%= note.selector %>" data-action="click->redpen#stop">
  <div class="redpen-note__head">
    <span class="redpen-note__number"></span>
    <span class="redpen-note__snippet" title="<%= note.snippet %>"><%= note.snippet.presence || note.selector %></span>
  </div>
  <p class="redpen-note__body"><%= note.body %></p>
  <% if note.resolved? %>
    <p class="redpen-note__resolution">
      <span class="redpen-note__label">Resolved <%= time_ago_in_words(note.resolved_at) %> ago</span>
      <% if note.resolution.present? %><span><%= note.resolution %></span><% end %>
    </p>
  <% end %>
  <div class="redpen-note__meta"><%= note.created_at.strftime("%-d %b %Y, %H:%M") %></div>
  <div class="redpen-note__actions">
    <%= button_to "Delete", writing_note_path(note), method: :delete, class: "redpen-btn redpen-btn--quiet", form: { data: { turbo_confirm: "Delete this note?" } } %>
    <% if note.resolved? %>
      <%= button_to "Reopen", writing_note_resolution_path(note), method: :delete, class: "redpen-btn" %>
    <% else %>
      <%= button_to "Resolve", writing_note_resolution_path(note), method: :post, class: "redpen-btn redpen-btn--primary" %>
    <% end %>
  </div>
</li>
