<%# The whole authoring surface: a distraction-free canvas (headline title + Lexxy body)
    with everything else — tags, feature image, SEO — tucked into a "Post settings"
    slide-over, and publishing into its own popover. One partial paints new + edit, posts +
    pages. On a saved record the form wears the autosave controller (silent debounced fetch;
    the feature-image file commits on blur); minting a tag is a deliberate act in its
    own <form>, a sibling below, so it never rides autosave. The editor controller owns the
    two overlays and their shared backdrop. %>
<%# Lexxy's editor CSS only belongs where the editor lives, so pull it in per-page rather
    than site-wide (public pages render stored bodies with gh-content). %>
<% content_for :head do %><%= stylesheet_link_tag "lexxy" %><% end %>
<% saving = post.persisted? %>

<%# bar rides the shell rather than the bar itself: what it shows lives up here, but what
    it shows it ABOUT — the canvas title, the prose — lives down in the canvas, and a
    Stimulus target has to be a descendant. The editor controller keeps the overlays. %>
<div class="editor-shell" data-controller="editor bar" data-editor-open-class="is-open"
     data-editor-autosave-outlet=".editor-shell__form"
     data-editor-open-publish-value="<%= publishing_open? %>"
     data-bar-reading-speed-value="<%= ApplicationHelper::READING_SPEED %>"
     data-action="keydown@window->editor#closeOnEscape
                  keydown@window->editor#trapFocus
                  keydown@window->editor#shortcutsOnSlash
                  keydown.meta+shift+p@window->editor#togglePublish:prevent
                  keydown.ctrl+shift+p@window->editor#togglePublish:prevent
                  keydown.meta+p@window->editor#preview:prevent
                  keydown.ctrl+p@window->editor#preview:prevent
                  turbo:before-cache@window->editor#beforeCache
                  lexxy:change->bar#recount">
  <div class="editor-shell__scrim" data-editor-target="backdrop" data-action="click->editor#close"></div>

  <%# Autosave rides the form in both states, and is the only save there is — no Save
      button. On a saved record it PATCHes silently; on a new record it POSTs once to mint
      the draft the moment there's real content, then swaps to the persisted PATCH URL in
      place. Leaving is guarded rather than blocked: an in-app visit waits for the pending
      save, a tab close gets the browser's own dialog while anything is unsaved. %>
  <%# local-save keeps the browser's own copy of the body while a save is still owed, keyed
      by record so two open posts can't trade drafts, and cleared only when autosave says
      the save landed — an event chain, so neither controller knows the other exists. %>
  <%= form_with model: [ :writing, post ], class: "editor-shell__form", data: {
        controller: "slug autosave local-save", autosave_persisted_value: saving,
        autosave_saved_text_value: autosave_saved_text(post), local_save_key_value: dom_id(post),
        action: "input->autosave#change lexxy:change->autosave#change " \
                "input->local-save#save lexxy:change->local-save#save autosave:saved->local-save#saved " \
                "turbo:submit-end->autosave#committed autosave:minted->slug#minted " \
                "autosave:slugged->slug#kept autosave:minted->local-save#rekey " \
                "turbo:before-morph-attribute@document->autosave#keepPanelOpen " \
                "turbo:before-visit@window->autosave#guardVisit " \
                "beforeunload@window->autosave#guardUnload " \
                "keydown.meta+s@window->autosave#flush:prevent " \
                "keydown.ctrl+s@window->autosave#flush:prevent",
        **slug_check_values(post) } do |form| %>
    <%= render "writing/posts/lock_version", post: post %>
    <header class="editor-bar" data-bar-target="chrome">
      <div class="editor-bar__side">
        <%= link_to writing_posts_path, class: "editor-bar__back", title: "Back to all writing" do %>
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>Writing</span>
        <% end %>
        <%= render "writing/posts/autosave_status", post: post %>
      </div>

      <%# Which post this is, once the canvas title has gone under the bar. A copy of the
          textarea's value, not a second field: empty while the post is untitled, and the
          stylesheet hides an empty one so there is no state to keep about that. %>
      <p class="editor-bar__title" data-bar-target="title" hidden></p>

      <div class="editor-bar__side editor-bar__side--end">
        <%# How much of it there is, on the way to Settings. Server-rendered so it is right
            before any JavaScript runs; the bar controller rewrites the three spans as the
            body grows, and the unit word rides as data because it is the one that changes
            with the number. %>
        <%= tag.p class: "editor-bar__count", data: { bar_target: "count", **word_unit_data } do %>
          <% words = word_count(post) %>
          <span data-bar-target="words"><%= number_with_delimiter(words) %></span>
          <span data-bar-target="wordUnit"><%= word_unit(words) %></span> ·
          <span data-bar-target="minutes"><%= reading_time(post) %></span> min
        <% end %>
        <button type="button" class="w-btn w-btn--ghost" data-action="editor#toggleSettings" aria-haspopup="dialog">
          <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M2 4h12M2 8h12M2 12h12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><circle cx="6" cy="4" r="2.2" fill="currentColor"/><circle cx="10" cy="8" r="2.2" fill="currentColor"/><circle cx="5" cy="12" r="2.2" fill="currentColor"/></svg>
          Settings
        </button>
        <div id="editor-actions" class="editor-bar__actions"><%= render "writing/posts/editor_actions", post: post if saving %></div>
      </div>
    </header>

    <%# What the record itself refused, which after an explicit (non-autosave) save is the
        only thing that lands here — every publishing refusal is shown inside the popover
        the writer was looking at when he caused it. The alert is the one refusal that
        arrives by redirect: an explicit save from a tab another tab had overtaken. %>
    <% refusals = post.errors.full_messages + [ flash[:alert] ].compact_blank %>
    <% if refusals.any? %>
      <ul class="errors">
        <% refusals.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>

    <div class="editor-canvas">
      <%= form.label :title, class: "sr-only" %>
      <%# Blank, not "Untitled", on a draft that never got a title: the placeholder is the
          model's way of letting body-first writing persist, not a title the writer typed,
          and showing it back would make him delete a word he never wrote. %>
      <%= form.text_area :title, rows: 1, class: "editor-canvas__title", placeholder: "Title",
            value: (post.title unless post.untitled?),
            autofocus: !saving, data: { controller: "autogrow", bar_target: "canvasTitle",
            action: "input->autogrow#grow input->editor#retitle input->bar#retitle" } %>

      <%# The excerpt is the standfirst: edited inline as a subtitle here (Ghost-style), the
          same attribute the public <h1> subtitle and social cards read. %>
      <%= form.label :excerpt, class: "sr-only" %>
      <%= form.text_area :excerpt, rows: 1, class: "editor-canvas__subtitle", placeholder: "Add a subtitle…",
            data: { controller: "autogrow", action: "input->autogrow#grow" } %>

      <%# The post's public address, on the canvas because that is where it is decided —
          the host and the trailing slash are the site's, the middle is the writer's.
          data-auto is who owns it: while the URL is still the editor's invention the field
          only ever displays what the last save kept (never a guess of its own, so it can't
          show a URL the site doesn't serve). The writer's first keystroke here takes it
          over for the session, and from then on it rides the silent save like the prose,
          committing on change. %>
      <div class="url-line">
        <span class="url-line__url"><span class="url-line__host"><%= Setting.current.production_host %>/</span><%=
          form.label :slug, "URL slug", class: "sr-only" %><%=
          form.text_field :slug, class: "url-line__slug", title: "Edit the URL", placeholder: "your-url",
            data: { slug_target: "slug", autosave_target: "slug", auto: post.new_record? || post.untitled?,
            action: "input->slug#edited input->slug#check change->slug#restore change->autosave#commitSlug" } %>/</span>
        <%# Availability, answered by the server as the writer types. %>
        <%= render "writing/slugs/status" %>
        <% if post.addressed? %>
          <p class="url-line__hint"><%= live_url_warning %></p>
        <% end %>
      </div>

      <%# All three controllers sit on the body because the body is all any of them touches:
          embed hears Lexxy announce a pasted link and swaps the supported ones for provider
          markup, html-card writes a fragment of the writer's own into the same editor, and
          slash-menu offers the blocks at the line being typed. The first two ask the server
          for what they insert; the third makes nothing at all — it clicks the toolbar, and
          hands its two other rows to the controllers that own them, which is why those two
          arrive here as events rather than as calls. The placeholder is where the writer
          learns all of it exists — one line, in the exact spot the blocks land, instead of
          a permanent bar under the body. %>
      <%# The body the browser kept when a save didn't land — a crash, a dead session, a
          tab closed past the warning. Offered, not forced: the controller reveals this
          only when the copy differs from what the server has, and the writer decides. %>
      <p class="draft-notice" hidden data-local-save-target="notice">
        Unsaved draft from <span data-local-save-target="age"></span> found —
        <button type="button" class="draft-notice__action" data-action="local-save#restore">Restore</button> ·
        <button type="button" class="draft-notice__action" data-action="local-save#discard">Discard</button>
      </p>

      <%# selection-bubble sits here too because the bubbles are about the body and nothing
          else: the caret, the toolbar they proxy to, and the box they position inside are
          all within this element. slash-menu is the fourth: it makes nothing itself — it
          clicks the toolbar for the blocks, and hands its two other rows to the controllers
          that own them, which is why those two arrive here as events rather than as calls. %>
      <div class="editor-canvas__body" data-controller="embed html-card selection-bubble slash-menu" data-bar-target="body"
           data-embed-url-value="<%= writing_embeds_path %>"
           data-html-card-url-value="<%= writing_html_cards_path %>"
           data-action="lexxy:insert-link->embed#unfurl
                        selectionchange@document->selection-bubble#follow
                        lexxy:blur->selection-bubble#dismiss
                        keydown@window->selection-bubble#dismissOnEscape
                        turbo:before-cache@window->selection-bubble#dismiss
                        keydown->slash-menu#navigate:capture
                        lexxy:change->slash-menu#sync
                        lexxy:blur->slash-menu#close
                        selectionchange@document->slash-menu#sync
                        turbo:before-cache@window->slash-menu#close
                        slash-menu:embed->embed#insert
                        slash-menu:card->html-card#open">
        <%# The URL a card's frame loads, with a hole where the sgid goes: the canvas fills
            it from the attachment and never builds an address of its own. %>
        <%= form.rich_text_area :body, data: { html_card_target: "editor", embed_target: "editor",
              slash_menu_target: "editor", local_save_target: "input",
              html_card_url_template: writing_html_card_path("__sgid__") },
              placeholder: "Start writing. Type / for blocks, ## for a heading, or paste a link on its own line to embed it." do %>
          <%= render "writing/posts/toolbar" %>
        <% end %>

        <%= render "writing/posts/slash_menu" %>

        <%# Writing a card is a rare, deliberate act — markup that will be served exactly as
            typed — so it stays folded away rather than sitting under the prose all day. The
            textarea has no name on purpose: what's in it isn't the post until the writer
            presses Insert, and a control without a name is one the form can't submit. %>
        <details class="card-composer" data-html-card-target="disclosure">
          <summary class="card-composer__summary">HTML card</summary>
          <textarea class="card-composer__source" rows="8" spellcheck="false"
                    placeholder="&lt;style&gt;…&lt;/style&gt;&lt;div&gt;…&lt;/div&gt;"
                    data-html-card-target="source"
                    data-action="input->html-card#keepOutOfAutosave"></textarea>
          <div class="card-composer__foot">
            <button type="button" class="w-btn w-btn--ghost w-btn--sm" data-action="html-card#insert">Insert HTML</button>
            <p class="card-composer__hint">A card can't be edited here — delete it and insert it again, or change its markup with the update_html_card tool.</p>
          </div>
        </details>

        <%= render "writing/posts/selection_bubble" %>
      </div>
    </div>

    <aside class="settings-panel" data-editor-target="settings" role="dialog" aria-label="Post settings">
      <header class="settings-panel__head">
        <h2>Post settings</h2>
        <%= render "writing/posts/autosave_status", post: post %>
        <button type="button" class="panel-close" data-action="editor#close" aria-label="Close settings">
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="m4 4 8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
      </header>

      <div class="settings-panel__body">
        <% if post.taggable? %>
          <div class="field">
            <span class="field__label">Tags</span>
            <%= render "writing/posts/tags", post: post %>
            <%# An empty slot on a canvas with no record yet; the mint's turbo_stream
                fills it, so a tag can be minted the moment the draft exists. %>
            <div id="editor-tag-mint"><%= render "writing/posts/tag_mint", post: post if saving %></div>
          </div>

          <hr class="settings-panel__rule">
        <% end %>

        <div class="field">
          <%= form.label :feature_image, "Feature image URL" %>
          <%= form.text_field :feature_image, placeholder: "https://…" %>
        </div>
        <div class="field feature-image-upload">
          <%= form.label :uploaded_feature_image, "…or upload a file" %>
          <%= form.file_field :uploaded_feature_image, accept: "image/*",
                data: { autosave_target: "file", action: "change->autosave#commit" } %>
          <% if post.feature_image_url.present? %>
            <%= image_tag post.feature_image_url, class: "feature-image-preview", alt: "Current feature image" %>
          <% end %>
        </div>
        <div class="field">
          <%= form.label :feature_image_caption, "Image caption" %>
          <%= form.text_field :feature_image_caption %>
        </div>

        <hr class="settings-panel__rule">

        <div class="field">
          <%= form.label :meta_title, "Meta title" %>
          <%= form.text_field :meta_title %>
        </div>
        <div class="field">
          <%= form.label :meta_description, "Meta description" %>
          <%= form.text_area :meta_description, rows: 2 %>
        </div>

        <hr class="settings-panel__rule">

        <%# The one way into the shortcut sheet that doesn't need a shortcut. %>
        <p class="settings-panel__aside">
          <button type="button" class="panel-link" data-action="editor#openShortcuts">Keyboard shortcuts</button>
          <kbd>⌘/</kbd>
        </p>

        <div id="editor-delete"><%= render "writing/posts/editor_delete", post: post if saving %></div>
      </div>
    </aside>
  <% end %>

  <%# Outside the form on purpose (nested forms get stripped by the parser), and behind a
      stable id so the mint can bring the whole persisted-post chrome in at once. %>
  <div id="editor-overlays"><%= render "writing/posts/editor_overlays", post: post if saving %></div>

  <%= render "writing/posts/shortcuts" %>
</div>
