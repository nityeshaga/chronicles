<%# The editor's own toolbar, supplied instead of Lexxy's default so the set and order
    are ours: text style, inline formats, link, then blocks — every tool a blog post
    uses in one row at the writing measure, no file attachment, no undo/redo (Cmd+Z does
    that, and the two slots are worth more). Lexxy finds a <lexxy-toolbar> inside the
    editor and binds it: a button's `name` is what its pressed state is painted by,
    `data-command` is what a click dispatches, `data-hotkey` is what the keyboard
    dispatches it with. The trailing overflow menu is part of its contract — Lexxy reads
    it whether or not anything ends up inside it — and only the phone ever fills it:
    direct-child buttons fall in from the end, so the ones that must survive at 390 px
    come first. Swatch and heading names arrive once Lexxy has generated those buttons. %>
<lexxy-toolbar data-controller="labels" data-action="lexxy:initialize@window->labels#label"
               data-labels-swatches-value="Yellow Orange Red Pink Purple Blue Green Brown Grey"
               data-labels-headings-value='{"h2":"Heading 2","h3":"Heading 3","h4":"Heading 4"}'>
  <lexxy-toolbar-dropdown class="lexxy-editor__toolbar-dropdown">
    <button data-dropdown-trigger class="lexxy-editor__toolbar-button lexxy-editor__toolbar-button--chevron" type="button" name="format" title="Text style" aria-label="Text style" aria-haspopup="menu" aria-expanded="false">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 3.5h8M6.5 3.5v9M10 8h4M12 8v4.5"/></svg>
    </button>
    <div data-dropdown-panel role="menu" class="lexxy-editor__toolbar-dropdown-list toolbar-styles" hidden>
      <button type="button" name="paragraph" data-command="setFormatParagraph" title="Paragraph" aria-label="Paragraph" role="menuitem"><span>Paragraph</span></button>
      <lexxy-heading-dropdown>
        <div class="lexxy-heading-options"></div>
      </lexxy-heading-dropdown>
    </div>
  </lexxy-toolbar-dropdown>

  <button class="lexxy-editor__toolbar-button" type="button" name="bold" data-command="bold" title="Bold (⌘B)" aria-label="Bold">
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 3h4a2.25 2.25 0 0 1 0 4.5h-4zM4.5 7.5H9a2.5 2.5 0 0 1 0 5H4.5z"/></svg>
  </button>
  <button class="lexxy-editor__toolbar-button" type="button" name="italic" data-command="italic" title="Italic (⌘I)" aria-label="Italic">
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M9.5 3h3.5M3 13h3.5M10 3l-4 10"/></svg>
  </button>
  <button class="lexxy-editor__toolbar-button" type="button" name="strikethrough" data-command="strikethrough" data-hotkey="cmd+shift+x ctrl+shift+x" title="Strikethrough (⌘⇧X)" aria-label="Strikethrough">
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 8h11M11 5.3C10.6 4 9.4 3.3 8 3.3c-1.8 0-3 .9-3 2.1 0 .5.2 1 .5 1.3M5 10.7c.4 1.3 1.6 2 3 2 1.8 0 3-.9 3-2.1 0-.3 0-.5-.1-.7"/></svg>
  </button>
  <button class="lexxy-editor__toolbar-button" type="button" name="code" data-command="inlineCode" data-hotkey="cmd+e ctrl+e" title="Inline code (⌘E)" aria-label="Inline code">
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5.5 5 2.5 8l3 3M10.5 5l3 3-3 3"/></svg>
  </button>

  <lexxy-link-dropdown class="lexxy-editor__toolbar-dropdown lexxy-editor__toolbar-dropdown--link">
    <button data-dropdown-trigger class="lexxy-editor__toolbar-button lexxy-editor__toolbar-group-end" type="button" name="link" data-hotkey="cmd+k ctrl+k" title="Link (⌘K)" aria-label="Link" aria-haspopup="dialog" aria-expanded="false">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6.5 9.5l3-3M5.3 6.8 3.6 8.5a2.6 2.6 0 0 0 3.7 3.7l1.7-1.7M10.7 9.2l1.7-1.7a2.6 2.6 0 0 0-3.7-3.7L7 5.5"/></svg>
    </button>
    <div data-dropdown-panel role="dialog" aria-label="Link" hidden>
      <input type="url" placeholder="https://…" aria-label="Link URL" class="input">
      <div class="lexxy-editor__toolbar-dropdown-actions">
        <button type="button" class="lexxy-editor__toolbar-button" value="link" title="Apply link" aria-label="Apply link">Link</button>
        <button type="button" class="lexxy-editor__toolbar-button" value="unlink" title="Remove link" aria-label="Remove link">Unlink</button>
      </div>
    </div>
  </lexxy-link-dropdown>

  <button class="lexxy-editor__toolbar-button" type="button" name="unordered-list" data-command="insertUnorderedList" title="Bullet list" aria-label="Bullet list">
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6.5 4h7M6.5 8h7M6.5 12h7"/><circle cx="3" cy="4" r="1" fill="currentColor" stroke="none"/><circle cx="3" cy="8" r="1" fill="currentColor" stroke="none"/><circle cx="3" cy="12" r="1" fill="currentColor" stroke="none"/></svg>
  </button>
  <button class="lexxy-editor__toolbar-button" type="button" name="ordered-list" data-command="insertOrderedList" title="Numbered list" aria-label="Numbered list">
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6.5 4h7M6.5 8h7M6.5 12h7M2.2 3.3l1.2-.8v3.3M2 9.6a1.2 1.2 0 0 1 2.3.5c0 .9-2.3 1.6-2.3 2.9h2.4"/></svg>
  </button>
  <button class="lexxy-editor__toolbar-button" type="button" name="quote" data-command="insertQuoteBlock" title="Quote" aria-label="Quote">
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6.5 4.5C4.3 5.2 3 6.8 3 9v2.5h3.5V8H4.6c0-1.3.7-2.2 1.9-2.7zM13.5 4.5c-2.2.7-3.5 2.3-3.5 4.5v2.5h3.5V8h-1.9c0-1.3.7-2.2 1.9-2.7z"/></svg>
  </button>
  <button class="lexxy-editor__toolbar-button" type="button" name="divider" data-command="insertHorizontalDivider" title="Divider" aria-label="Divider">
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h12M5 4h6M5 12h6"/></svg>
  </button>
  <button class="lexxy-editor__toolbar-button" type="button" name="code-block" data-command="insertCodeBlock" title="Code block" aria-label="Code block">
    <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="3" width="12" height="10" rx="1.5"/><path d="m6.5 6.5-1.5 1.5 1.5 1.5M9.5 6.5 11 8l-1.5 1.5"/></svg>
  </button>
  <button class="lexxy-editor__toolbar-button" type="button" name="table" data-command="insertTable" title="Table" aria-label="Table">
    <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="3" width="12" height="10" rx="1.5"/><path d="M2 7h12M7 3v10"/></svg>
  </button>
  <button class="lexxy-editor__toolbar-button" type="button" name="image" data-command="uploadImage" data-prevent-overflow="true" title="Image" aria-label="Image">
    <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="3" width="12" height="10" rx="1.5"/><circle cx="5.5" cy="6.5" r="1.1"/><path d="m2.5 11.5 3.5-3.5 2.5 2.5 2-2 3 3"/></svg>
  </button>

  <lexxy-highlight-dropdown class="lexxy-editor__toolbar-dropdown lexxy-editor__toolbar-dropdown--highlight">
    <button data-dropdown-trigger class="lexxy-editor__toolbar-button lexxy-editor__toolbar-button--chevron" type="button" name="highlight" title="Text colour" aria-label="Text colour" aria-haspopup="menu" aria-expanded="false">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 2.5l3.5 3.5-6.5 6.5H3.5V9zM8.5 4l3.5 3.5M2.5 14.5h11"/></svg>
    </button>
    <div data-dropdown-panel role="menu" aria-label="Text colour" hidden>
      <span class="toolbar-panel__label">Text colour, then background</span>
      <div class="lexxy-highlight-colors"></div>
      <button data-command="removeHighlight" type="button" class="lexxy-editor__toolbar-button lexxy-editor__toolbar-dropdown-reset" role="menuitem" title="Remove colour" aria-label="Remove colour">Remove colour</button>
    </div>
  </lexxy-highlight-dropdown>

  <lexxy-toolbar-dropdown class="lexxy-editor__toolbar-dropdown lexxy-editor__toolbar-button--push-right lexxy-editor__toolbar-overflow">
    <button data-dropdown-trigger class="lexxy-editor__toolbar-button" type="button" title="More tools" aria-label="More tools" aria-haspopup="menu" aria-expanded="false">
      <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="3" cy="8" r="1.3" fill="currentColor" stroke="none"/><circle cx="8" cy="8" r="1.3" fill="currentColor" stroke="none"/><circle cx="13" cy="8" r="1.3" fill="currentColor" stroke="none"/></svg>
    </button>
    <div data-dropdown-panel role="menu" class="lexxy-editor__toolbar-overflow-menu" aria-label="More tools" hidden></div>
  </lexxy-toolbar-dropdown>
</lexxy-toolbar>
