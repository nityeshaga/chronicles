<%# Publish / schedule / unpublish controls, shown inside the publish popover (delete lives
    at the foot of the Settings slide-over, off the ship flow).
    Shared by post and page editors — the paths are polymorphic, so the same partial drives
    both. Pages publish exactly like posts (the publishing resource is nested under both). %>
<div class="publish-popover__body">
  <% if post.published? %>
    <p class="publish-state">
      <span class="status status--published">Live</span>
      Published <%= post.published_at.strftime("%-d %b %Y, %-l:%M %p") %>.
    </p>
    <%# No View live here: the editor bar carries it, and one control per meaning. %>
    <div class="publish-actions">
      <%= button_to "Unpublish", [ :writing, post, :publishing ], method: :delete,
            class: "w-btn w-btn--ghost w-btn--sm", form_class: "w-inline",
            data: { action: "click->editor#commitThenSubmit" } %>
    </div>

    <%# Newsletter: a published post can be mailed to the list exactly once. After it
        goes out, the button is replaced by the sent stamp so it can't be re-sent.
        With nobody subscribed there is nothing to send, so the button is absent rather
        than disabled — a control that can only fail is noise. The button that remains is
        a ghost: same weight as Unpublish, so the LIVE pill stays the loudest thing here.
        Pages share this popover but aren't newsletterable, so they skip the block. %>
    <% if post.newsletterable? %>
    <div class="publish-newsletter">
      <% if post.newsletter_sent? %>
        <p class="publish-state">
          <span class="status status--published">Sent</span>
          Mailed to <%= link_to post.newsletter_recipients_count ? pluralize(post.newsletter_recipients_count, "subscriber") : "subscribers", writing_subscribers_path %>
          <%= post.newsletter_sent_at.strftime("%-d %b %Y, %-l:%M %p") %>.
        </p>
      <% elsif post.newsletter_ready? %>
        <% count = Subscriber.count %>
        <p class="publish-state"><span>Goes to <%= link_to pluralize(count, "subscriber"), writing_subscribers_path %>.</span></p>
        <%= button_to "Send as newsletter", [ :writing, post, :newsletter ], method: :post,
              class: "w-btn w-btn--ghost w-btn--sm", form_class: "w-inline",
              data: { turbo_confirm: "Mail this post to all #{pluralize(count, "subscriber")}? This can’t be undone." } %>
      <% else %>
        <%# Live, unsent and not ready leaves exactly one case: nobody to send to. %>
        <p class="publish-state"><span>No <%= link_to "subscribers", writing_subscribers_path %> yet — nothing to send.</span></p>
      <% end %>
    </div>
    <% end %>
  <% elsif post.scheduled? %>
    <p class="publish-state">
      <span class="status status--scheduled">Scheduled</span>
      Goes live <%= post.published_at.strftime("%-d %b %Y, %-l:%M %p") %>.
    </p>
    <%= button_to "Cancel schedule", [ :writing, post, :publishing ], method: :delete,
          class: "w-btn w-btn--ghost w-btn--sm", form_class: "w-inline",
          data: { action: "click->editor#commitThenSubmit" } %>
  <% else %>
    <%# Every button here waits for a pending autosave before it submits: publishing
        re-renders the canvas from the record, so a debounce still in flight would come
        back as an older body — and then save itself over the newer one. %>
    <%= form_with url: [ :writing, post, :publishing ], method: :post, class: "schedule-form" do |form| %>
      <%# An untitled post would go live at /untitled/ — a URL no rename takes back. The
          model refuses it; this says so, and the title field re-enables the button live. %>
      <%= tag.p class: "publish-note", hidden: !post.untitled?, data: { editor_target: "titleNote" } do %>
        Give it a title first — right now it would go live at <%= Setting.current.production_host %>/<%= post.slug %>/.
      <% end %>
      <%= label_tag :published_at do %>Publish time <span class="field__hint">— leave blank to go live now</span><% end %>
      <%= datetime_field_tag :published_at %>
      <%= form.submit "Publish", class: "w-btn w-btn--primary", disabled: post.untitled?,
            data: { editor_target: "publishSubmit", action: "click->editor#commitThenSubmit" } %>
    <% end %>
  <% end %>
</div>
