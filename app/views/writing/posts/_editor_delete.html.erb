<%# Delete lives at the foot of settings (Ghost's convention), off the ship flow. The
    button belongs to the sibling #delete-post form — a button_to here would nest a <form>
    inside the edit form, and the HTML parser strips the inner tag, turning Delete into a
    submit button of the edit form (a silent PATCH). %>
<hr class="settings-panel__rule">
<div class="settings-panel__danger">
  <%= button_tag "Delete #{post.model_name.human.downcase}", form: "delete-post",
        class: "w-btn w-btn--danger w-btn--sm",
        data: { turbo_confirm: "Delete this #{post.model_name.human.downcase} for good?" } %>
</div>
