<%# The explorable editor: the HTML-page editor's title, slug and document — the document
    here is the bundle's index.html — with the bundle's other files listed beneath it. The
    files are read-only on this side; a directory of decks and scripts is uploaded and
    revised through the MCP tools (create_explorable / update_explorable), never typed. %>
<div class="form-page">
  <header class="form-page__head">
    <%= link_to writing_posts_path, class: "editor-bar__back" do %>
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span>Writing</span>
    <% end %>
    <h1>Edit explorable</h1>
    <%= render "writing/posts/view_button", post: post, size: "w-btn--sm" %>
  </header>

  <%= form_with model: [ :writing, post ], class: "stacked-form",
        data: { controller: "slug", **slug_check_values(post) } do |form| %>
    <% if post.errors.any? %>
      <ul class="errors">
        <% post.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>

    <% if flash[:notice].present? %>
      <p class="autosave-status" data-state="saved"><%= flash[:notice] %></p>
    <% end %>

    <div class="field">
      <%= form.label :title %>
      <%= form.text_field :title %>
      <small class="field__hint">Only the writing dashboard and the MCP listings show this — the served page uses the <code>&lt;title&gt;</code> in index.html.</small>
    </div>

    <div class="field">
      <%= form.label :slug, "URL slug" %>
      <%= form.text_field :slug, data: { slug_target: "slug", action: "input->slug#check" } %>
      <%= render "writing/slugs/status" %>
      <small class="field__hint">The explorable's public URL: <code>/<%= post.slug.presence || "…" %>/</code>. Every file lives under it.<%= " #{live_url_warning}" if post.addressed? %></small>
    </div>

    <div class="field">
      <%= form.label :raw_html, "index.html" %>
      <%= form.text_area :raw_html, rows: 30, class: "html-source", spellcheck: false,
            autocomplete: "off", autocapitalize: "off", autocorrect: "off" %>
      <small class="field__hint">The front door of the bundle, served verbatim at <code>/<%= post.slug %>/</code>. Relative paths resolve against the files below.</small>
    </div>

    <%= form.submit "Save explorable", class: "w-btn w-btn--primary" %>
  <% end %>

  <section class="editor-panel">
    <h2>Files <span class="dash-tab__count"><%= post.assets.size %></span></h2>
    <% if post.assets.none? %>
      <p class="editor-panel__note">Just index.html so far. Add files with the update_explorable MCP tool.</p>
    <% else %>
      <ul class="file-list">
        <% post.assets.order(:path).each do |asset| %>
          <li class="file-list__row">
            <%= link_to asset.path, explorable_asset_path(post, asset.path), target: "_blank", rel: "noopener", class: "file-list__path" %>
            <span class="file-list__meta"><%= asset.content_type %> · <%= number_to_human_size(asset.size) %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
    <% if (missing = post.missing_references).any? %>
      <p class="editor-panel__note editor-panel__note--warn">Referenced but not in the bundle: <%= missing.map { |path| tag.code(path) }.join(", ").html_safe %></p>
    <% end %>
  </section>

  <section class="editor-panel">
    <h2>Publishing</h2>
    <%= render "writing/posts/publishing", post: post %>
  </section>

  <div class="editor-panel__danger">
    <%= button_to "Delete explorable", [ :writing, post ], method: :delete,
          class: "w-btn w-btn--danger w-btn--sm", form_class: "w-inline",
          data: { turbo_confirm: "Delete this explorable and all #{pluralize(post.assets.size, "file")} for good?" } %>
  </div>
</div>
