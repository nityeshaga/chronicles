<% content_for :title, "Tags" %>

<div class="writing-dash">
  <header class="dash-head">
    <div class="dash-head__brand">
      <span class="dash-eyebrow"><%= Setting.current.production_host %></span>
      <h1>Tags</h1>
    </div>
    <div class="dash-head__actions">
      <%= link_to writing_posts_path, class: "w-btn w-btn--ghost" do %>
        <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Writing
      <% end %>
    </div>
  </header>

  <% if @tags.empty? %>
    <div class="dash-blank"><p>No tags yet. They appear here once a post is filed under one.</p></div>
  <% else %>
    <%# The whole row has always been a link to the edit page; nothing said so. The Edit
        button is the label the row was missing — and the row hover lights the name from
        anywhere on it, so the button and the row read as one target. %>
    <ul class="dash-list dash-list--tags">
      <% @tags.each do |tag| %>
        <li class="dash-row">
          <%= link_to edit_writing_tag_path(tag), class: "dash-row__link" do %>
            <span class="dash-row__title"><%= tag.name %></span>
            <span class="dash-row__slug"><code>/tag/<%= tag.slug %></code></span>
          <% end %>
          <span class="dash-row__side">
            <span class="dash-row__date"><%= pluralize tag.posts.count, "post" %></span>
            <%# Same destination as the row link, so it is a label for that control, not a
                second one: out of the tab order and out of the accessibility tree, or every
                row would cost two tab stops and announce its tag twice. %>
            <%= link_to "Edit", edit_writing_tag_path(tag), class: "w-btn w-btn--ghost w-btn--sm",
                  tabindex: -1, aria: { hidden: true } %>
          </span>
        </li>
      <% end %>
    </ul>
    <p class="dash-note">New tags are made from a post's Settings, so a tag never exists without a post.</p>
  <% end %>
</div>
