<% content_for :body_class, "error-template" %>
<% content_for :meta_title, "404 — Page not found" %>

<main class="gh-main gh-outer">
  <section class="gh-error gh-inner">
    <h1 class="error-code">404</h1>
    <p class="error-message">Page not found</p>
    <%= link_to "Go to the front page &rarr;".html_safe, root_path %>
  </section>
</main>
