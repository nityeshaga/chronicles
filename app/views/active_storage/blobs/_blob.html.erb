<%# An editor upload on the public page. Twin of the Lexxy node that paints it in the canvas —
    see ImageCardsHelper. `blob` is the attachment, which carries what the editor said about
    the image (alt, caption, size) and delegates the rest to the blob itself. %>
<% if !blob.representable? %>
<%= link_to blob.filename, url_for(blob.attachable) %>
<% elsif local_assigns[:in_gallery] %>
<div class="kg-gallery-image"><%= tag.img src: url_for(blob.attachable), srcset: kg_image_srcset(blob), sizes: "(min-width: 720px) 720px", alt: blob.node["alt"].to_s, width: blob.node["width"], height: blob.node["height"], loading: "lazy" %></div>
<% else %>
<%= kg_image_card src: url_for(blob.attachable), srcset: kg_image_srcset(blob), sizes: "(min-width: 720px) 720px",
      alt: blob.node["alt"], caption: blob.caption, width: blob.node["width"], height: blob.node["height"] %>
<% end %>
