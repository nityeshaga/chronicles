<% content_for :body_class, "home-template" %>

<%# The clock: a compact hero whose numbers are the point. %>
<section class="hero"><div class="wrap">
  <h1 class="reveal">Everything I ship, <em>the day</em> it ships. Built with <span class="l">Luo</span>, my AI employee.</h1>
  <div class="stats reveal">
    <% if (latest = @ships.first) %>
      <% days = days_since(latest.shipped_on) %>
      <div class="stat"><div class="lab"><span class="tick"></span>Last one</div><div class="big"><%= days %><span class="unit"><%= "day".pluralize(days) %> ago</span></div></div>
    <% end %>
    <div class="stat"><div class="lab">In the last 6 months</div><div class="big"><%= @ships.count { |ship| ship.shipped_on >= 6.months.ago.to_date } %><span class="unit">things</span></div></div>
    <div class="stat"><div class="lab">Apps running</div><div class="big"><%= Machine.all.size %></div></div>
  </div>
</div></section>

<%# The log. --age counts months back from the newest, so the paper yellows as you scroll. %>
<section class="log"><div class="wrap rail">
  <% @months.each.with_index(1) do |(month, ships), age| %>
    <%= render "ships/month", month:, ships:, age: %>
  <% end %>
</div></section>

<%= render "ships/subscribe" %>
