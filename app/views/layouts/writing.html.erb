<!DOCTYPE html>
<%# The author's workbench runs on its own chrome — no reader banner, centered logo, or
    footer. A writing surface should get out of the writer's way, so this layout is a bare
    shell: the same fonts and site stylesheet as the public pages (typographic continuity),
    nothing else. Preview (posts#show) deliberately keeps the public layout so "how it'll
    look live" really does. %>
<html lang="en" class="has-dark-text">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= content_for(:title).presence || "Writing" %> · <%= Setting.current.production_host %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <meta name="robots" content="noindex, nofollow">

    <%= render "layouts/fonts" %>
    <%# Inter is the workbench's own: buttons, menus, status — never the prose. %>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">

    <link rel="icon" href="/favicon.png" type="image/png">
    <link rel="apple-touch-icon" href="/favicon.png">

    <%= yield :head %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags "writing" %>
  </head>

  <body class="writing-app">
    <%= yield %>
  </body>
</html>
