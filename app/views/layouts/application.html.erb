<!DOCTYPE html>
<html lang="en" class="has-dark-text">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= render "layouts/fonts" %>

    <%= render "shared/meta" %>

    <link rel="icon" href="/favicon.png" type="image/png">
    <link rel="apple-touch-icon" href="/favicon.png">

    <%= yield :head %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= content_for(:body_class) %> has-serif-title has-serif-body" data-controller="reveal">
    <div class="gh-viewport">
      <header class="masthead-print">
        <div class="wrap mast-band">
          <h1 class="wordmark"><a href="<%= root_path %>"><%= wordmark(Setting.current.site_title) %></a></h1>
          <nav class="mast-nav">
            <% if signed_in? %><a class="admin-link" href="/writing/">Dashboard</a><% end %>
            <a class="mast-subscribe" href="/#subscribe">Get the next launch</a>
          </nav>
        </div>
      </header>

      <%= yield %>

      <footer class="site-footer">
        <div class="wrap">
          <div class="foot-kicker mono">Est. 2017 · Written, drawn &amp; compiled in Kolkata</div>
          <div class="mono">❦ <%= Setting.current.author_name %> · built with Luo, my AI agent, on a spare MacBook Air</div>
          <div class="links mono">
            <a href="https://myspool.xyz">Spool</a>
            <a href="https://teachmesomething.xyz">Teach Me Something</a>
            <a href="https://curatedconnections.io">Curated Connections</a>
            <a href="https://github.com/nityeshaga">GitHub</a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
