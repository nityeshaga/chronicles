<!DOCTYPE html>
<html lang="en" class="has-dark-text">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= render "layouts/fonts" %>

    <%= render "shared/meta" %>

    <link rel="icon" href="/favicon.png" type="image/png">
    <link rel="apple-touch-icon" href="/favicon.png">

    <%= yield :head %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= content_for(:body_class) %> has-serif-title has-serif-body" data-controller="reveal">
    <div class="gh-viewport">
      <header class="mast">
        <div class="wrap top">
          <a class="brand" href="<%= root_path %>"><span class="dot"></span>&nbsp;&nbsp;<%= Setting.current.author_name %></a>
          <a class="cta" href="/#subscribe"><span class="l">Get new stuff by email</span><span class="s">Subscribe</span></a>
        </div>
        <div class="tier2">
          <nav class="wrap nav">
            <a href="<%= root_path %>" class="<%= "on" if current_page?(root_path) %>">Latest</a>
            <a href="/apps/" class="k-app <%= "on" if on_page?(apps_path) %>" data-k="app"><span class="ki"></span>Apps</a>
            <a href="/explorables/" class="k-explorable <%= "on" if on_page?(explorables_path) %>" data-k="explorable"><span class="ki"></span>Explorables</a>
            <a href="/comics/" class="k-comic <%= "on" if on_page?(comics_path) %>" data-k="comic"><span class="ki"></span>Comics</a>
            <a href="/essays/" class="k-chronicle <%= "on" if on_page?(essays_path) %>" data-k="chronicle"><span class="ki"></span>Essays</a>
            <a href="/about/" class="about <%= "on" if on_page?("/about") %>">About</a>
          </nav>
        </div>
      </header>

      <%= yield %>

      <footer class="foot wrap">
        <span>Est. 2017 · India · <span class="ink-n">■</span> Nityesh <span class="ink-l">■</span> Luo</span>
        <span><a href="https://x.com/nityeshaga">X</a> &nbsp;·&nbsp; <a href="https://github.com/nityeshaga">GitHub</a> &nbsp;·&nbsp; <a href="/rss/">RSS</a> &nbsp;·&nbsp; <a href="https://github.com/nityeshaga/chronicles">This site's source</a></span>
      </footer>
    </div>

    <%= render "writing/notes/rail" if signed_in? %>
  </body>
</html>
