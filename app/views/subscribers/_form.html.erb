<%# locals: (subscriber: nil) %>
<%# Self-replacing region — the Turbo Stream swaps this whole div. %>
<div id="subscribe_form">
  <%= form_with url: subscribers_path, class: "sub-form" do |form| %>
    <%= form.label :email, "To", class: "to" %>
    <%= form.email_field :email, value: subscriber&.email, placeholder: "you@wherever.com",
          autocomplete: "email", required: true %>
    <button type="submit">Get new stuff by email</button>
  <% end %>
  <% if subscriber&.errors&.any? %>
    <p class="fine error">That address didn't look right. Try again?</p>
  <% end %>
  <div class="fine">One email at a time · unsubscribe anytime</div>
</div>
