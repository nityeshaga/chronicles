<% content_for :body_class, @post.body_class %>

<%# By kind: posts/_post for an article, pages/_page for a page. %>
<%= render @post %>

<%# Outside the fragment cache above — the pill must never be baked into the
    copy an anonymous reader is served. %>
<% if signed_in? %>
  <%= link_to "Edit", @post.is_a?(Page) ? edit_writing_page_path(@post) : edit_writing_post_path(@post), class: "edit-pill admin-link" %>
<% end %>
