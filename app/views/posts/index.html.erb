<% content_for :body_class, "home-template" %>

<%# ============ INTRO (frontispiece) ============ %>
<section class="hero">
  <div class="doodle doodle-hero" aria-hidden="true">
    <svg viewBox="0 0 100 60" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M15 34 c-2 -9 7 -15 15 -13 c8 2 11 9 9 16 c-2 7 -11 11 -17 7 c-5 -3 -7 -6 -7 -10 z"/>
      <path d="M57 33 c-1 -9 8 -14 16 -12 c8 2 10 9 8 15 c-2 7 -10 11 -16 8 c-6 -3 -8 -7 -8 -11 z"/>
      <path d="M39 32 c3 -4 11 -4 16 -1"/>
      <path d="M13 31 l-9 -6"/>
      <path d="M82 30 l9 -7"/>
    </svg>
  </div>
  <div class="wrap hero-grid">
    <figure class="portrait rise" style="--d:1">
      <%= image_tag "/content/images/2024/12/nityesh-headshot-1.jpeg", alt: Setting.current.author_name, class: "photo" %>
      <figcaption>The proprietor, at his desk.</figcaption>
    </figure>
    <div class="hero-copy rise" style="--d:2">
      <p class="lead">Hi, I'm Nityesh. I build software with a lot of help from AI. This website is my experiment in the next shape of personal publishing: a publishing house with one employee and no deadlines.</p>
      <p>Once, a person with something to say could only print <b>essays</b>. I still write those. But the presses got stranger: now I also draw <b>comics</b> about ideas that deserve pictures, and — this is the new part — I publish <b>full working software</b>. Real tools, free to use, maintained the way a book stays in print — all of it built by me and my AI agent, Luo, on a spare MacBook Air.</p>
      <p>Everything here is <span class="truth">optimised for truth, not engagement</span>.</p>
      <a class="thesis-btn" href="/about/">Read the full thesis</a>
    </div>
  </div>
</section>

<%# ============ LATEST WRITING ============ %>
<section id="press">
  <div class="doodle doodle-press" aria-hidden="true">
    <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M68 8 l17 15 -33 38 c-3 3 -8 4 -10 1 c-2 -3 -1 -7 2 -10 z"/>
      <path d="M60 39 c2 2 4 3 7 3"/>
      <path d="M50 66 c-2 4 -5 7 -9 8"/>
      <path d="M6 90 c8 -7 13 3 21 -2 c7 -4 12 -1 19 -4 c5 -2 9 -1 12 0"/>
    </svg>
  </div>
  <div class="wrap">
    <div class="sec-label rise">The writing</div>
    <h2 class="rise">Fresh off the press.</h2>
    <div class="press-list rise">
      <% @posts.first(3).each do |post| %>
        <article class="press-item">
          <% if post.published_at %>
            <time class="press-date mono" datetime="<%= post.published_at.strftime("%Y-%m-%d") %>"><%= post.published_at.strftime("%b %-d, %Y") %></time>
          <% end %>
          <div class="press-body">
            <h3 class="press-title"><%= link_to post.title, public_post_path(post) %></h3>
            <% if post.excerpt.present? %>
              <p class="press-excerpt"><%= post.excerpt %></p>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  </div>
</section>

<%# ============ THE MACHINES ============ %>
<section id="apps">
  <div class="doodle doodle-apps" aria-hidden="true">
    <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M17 10 c-1 7 2 11 8 13 l46 48 c3 3 8 3 11 0 c3 -3 3 -8 0 -11 L34 13 c-2 -6 -7 -9 -13 -8 l7 8 -3 6 -6 2 z"/>
      <path d="M83 14 l-14 13 -6 -1 -38 40"/>
      <path d="M85 16 c3 3 2 6 -1 9 l-13 10"/>
      <path d="M23 68 c-3 5 -8 6 -11 11 c-2 4 1 8 5 7 c5 -1 6 -7 11 -10"/>
    </svg>
  </div>
  <div class="wrap">
    <div class="sec-label rise">The apps</div>
    <h2 class="rise">Three places I built.</h2>
    <p class="sec-lede rise">Each one is a real, working product — live right now, free to use. Nothing here is a screenshot of past glory.</p>

    <div class="machines">

      <%# SPOOL %>
      <article class="machine rise">
        <div class="scene sc-spool" aria-hidden="true">
          <div class="chrome"><i></i><i></i><i></i><span class="url">any tab, honestly</span></div>
          <div class="rec"><i></i> Recording this tab</div>
          <div class="bar"></div>
          <div class="tick">take 1 · <b>00:14</b> · no login, no watermark</div>
        </div>
        <h3 class="machine-title"><a href="https://myspool.xyz">Spool</a></h3>
        <p class="machine-blurb">A Chrome extension for screen recording that stays out of your way: click, talk, share a link. The whole pitch fits in that sentence.</p>
        <div class="acts"><a class="use" href="https://myspool.xyz">Add to Chrome&nbsp;↗</a></div>
      </article>

      <%# TEACH ME SOMETHING %>
      <article class="machine rise">
        <div class="scene sc-tms" aria-hidden="true">
          <div class="chrome"><i></i><i></i><i></i><span class="url">teachmesomething.xyz/why-is-the-sky-blue</span></div>
          <div class="row r1"></div><div class="row r2"></div><div class="row r3"></div><div class="row r4"></div>
          <div class="panel">✦</div>
          <div class="cap">drawing you a comic about Rayleigh scattering…</div>
        </div>
        <h3 class="machine-title"><a href="https://teachmesomething.xyz">Teach Me Something</a></h3>
        <p class="machine-blurb">An AI tutor that teaches any topic you name — and draws its own diagrams and comics while it explains, because a sketch beats a paragraph.</p>
        <div class="acts"><a class="use" href="https://teachmesomething.xyz">Open it&nbsp;↗</a></div>
      </article>

      <%# CURATED CONNECTIONS %>
      <article class="machine rise">
        <div class="scene sc-cc" aria-hidden="true">
          <div class="chrome"><i></i><i></i><i></i><span class="url">curatedconnections.io</span></div>
          <div class="m ma">RS</div>
          <div class="m mb">AK</div>
          <div class="link"></div>
          <div class="word">matched · both said yes</div>
        </div>
        <h3 class="machine-title"><a href="https://curatedconnections.io">Curated Connections</a></h3>
        <p class="machine-blurb">Member matching for online communities. One flat price, unlimited members, no per-seat math — the app that started the whole experiment.</p>
        <div class="acts"><a class="use" href="https://curatedconnections.io">Open it&nbsp;↗</a></div>
      </article>

    </div>
  </div>
</section>

<%# ============ LIBRARY ============ %>
<section id="library">
  <div class="doodle doodle-library" aria-hidden="true">
    <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M50 32 c-8 -6 -19 -8 -29 -6 l-2 39 c10 -2 21 0 30 6"/>
      <path d="M50 32 c8 -6 19 -8 29 -6 l2 39 c-10 -2 -21 0 -30 6"/>
      <path d="M50 32 l-1 39"/>
      <path d="M27 37 c6 -1 13 0 19 2"/>
      <path d="M27 45 c6 -1 13 0 19 2"/>
      <path d="M55 39 c6 -2 12 -3 18 -2"/>
      <path d="M64 28 l1 -15 6 5 5 -7 1 14"/>
    </svg>
  </div>
  <div class="wrap">
    <div class="sec-label rise">The library</div>
    <h2 class="rise">Every era of my life, bound and shelved.</h2>
    <p class="sec-lede rise">The essays aren't going anywhere — they're shelved by who I was when I wrote them, left to right. The last book is still being written. Pull one down.</p>

    <div class="shelf-scene rise">
      <div class="shelf-books">
        <% @eras.each do |era| %>
          <% style = era_style(era) %>
          <a class="book <%= style[:book] %>" href="<%= public_tag_path(era) %>">
            <% if style[:ribbon] %><span class="ribbon"></span><% end %>
            <span class="bands"></span>
            <span class="spine-title"><%= era.name %></span>
            <span class="count"><%= era.published_article_count %></span>
          </a>
        <% end %>
        <div class="plant"><span class="leaf"></span><span class="leaf"></span><span class="leaf"></span><span class="pot"></span></div>
      </div>
      <div class="shelf-board"></div>
    </div>
  </div>
</section>

<%# ============ OPEN SOURCE ============ %>
<section id="source">
  <div class="doodle doodle-source" aria-hidden="true">
    <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M50 10 c4 0 7 3 7 7 c0 4 -3 7 -7 7 c-4 0 -7 -3 -7 -7 c0 -4 3 -7 7 -7 z"/>
      <path d="M50 25 l0 16"/>
      <path d="M50 41 c1 11 -16 10 -17 21 l0 7"/>
      <path d="M50 41 c-1 11 17 10 17 21 l1 7"/>
      <path d="M33 76 c4 0 7 3 7 7 c0 4 -3 7 -7 7 c-4 0 -7 -3 -7 -7 c0 -4 3 -7 7 -7 z"/>
      <path d="M68 76 c4 0 7 3 7 7 c0 4 -4 7 -8 7 c-4 0 -6 -3 -6 -7 c0 -4 3 -7 7 -7 z"/>
    </svg>
  </div>
  <div class="wrap">
    <div class="sec-label rise">Source included</div>
    <h2 class="rise">The workshop is open.</h2>
    <p class="sec-lede rise">A publishing house with a print room you can walk into. The machinery behind all of this is on GitHub.</p>
    <div class="repos">
      <a class="repo rise" href="https://github.com/nityeshaga/claude-home-base">
        <div class="path"><span class="dim">nityeshaga /</span> claude-home-base</div>
        <p>An always-on AI cofounder that runs on your own Mac — the bot, setup, and plugins behind the third member of our team. Fork it, configure it, let it come alive.</p>
        <div class="meta">Python · Claude Code · fork it yourself</div>
      </a>
      <a class="repo rise" href="https://github.com/everyinc/hands-on-deck">
        <div class="path"><span class="dim">everyinc /</span> hands-on-deck</div>
        <p>Agent-native PowerPoint: one CLI that lets an AI inspect, edit, build, and check .pptx files through atomic JSON patches. Packaged as an Agent Skill.</p>
        <div class="meta">Python · Agent Skill · from my day job at Every</div>
      </a>
    </div>
  </div>
</section>

<%# ============ SUBSCRIBE ============ %>
<section id="subscribe">
  <div class="doodle doodle-subscribe" aria-hidden="true">
    <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14 52 l74 -30 -34 52 -8 -20 z"/>
      <path d="M46 54 l42 -32"/>
      <path d="M46 54 l-2 16 8 -12"/>
      <path d="M8 92 c16 5 30 0 36 -14" stroke-dasharray="1 8"/>
    </svg>
  </div>
  <div class="wrap">
    <div class="letter rise">
      <span class="stamp"><span class="stamp-inner" style="background:#fbf2df"><span style="font-family:var(--serif);font-style:italic;font-size:20px;color:#b05c34">N</span><span class="mono" style="color:#96491f">First class</span></span></span>
      <h2>Get the next shipment.</h2>
      <p>Not a newsletter. When I finish something, I send it to you: <b>a polished app you can use that day</b>, a fun comic, and the articles on how it all got made.</p>
      <p style="margin-top:14px"><b>No cadence. I ship when I ship.</b> Lately, I ship often.</p>
      <% if flash[:notice].present? %>
        <%# HTML fallback for a JS-less signup — Turbo handles the happy path in-place. %>
        <div id="subscribe_form">
          <p class="sub-confirm"><%= flash[:notice] %></p>
          <div class="sub-fine">One shipment at a time · unsubscribe anytime</div>
        </div>
      <% else %>
        <% if flash[:alert].present? %><p class="sub-fine sub-error"><%= flash[:alert] %></p><% end %>
        <%= render "subscribers/form" %>
      <% end %>
    </div>
  </div>
</section>
