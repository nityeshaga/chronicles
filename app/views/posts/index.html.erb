<% content_for :body_class, "home-template" %>

<%# ============ INTRO (frontispiece) ============ %>
<section class="hero">
  <div class="doodle doodle-hero" aria-hidden="true">
    <svg viewBox="0 0 100 60" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M15 34 c-2 -9 7 -15 15 -13 c8 2 11 9 9 16 c-2 7 -11 11 -17 7 c-5 -3 -7 -6 -7 -10 z"/>
      <path d="M57 33 c-1 -9 8 -14 16 -12 c8 2 10 9 8 15 c-2 7 -10 11 -16 8 c-6 -3 -8 -7 -8 -11 z"/>
      <path d="M39 32 c3 -4 11 -4 16 -1"/>
      <path d="M13 31 l-9 -6"/>
      <path d="M82 30 l9 -7"/>
    </svg>
  </div>
  <div class="wrap hero-grid">
    <figure class="portrait rise" style="--d:1">
      <%= image_tag "/content/images/2024/12/nityesh-headshot-1.jpeg", alt: Setting.current.author_name, class: "photo" %>
      <figcaption>The proprietor, at his desk.</figcaption>
    </figure>
    <div class="hero-copy rise" style="--d:2">
      <p class="lead">Hi, I'm Nityesh. I build software with a lot of help from AI. This website is my experiment in the next shape of personal publishing: a publishing house with one employee and no deadlines.</p>
      <p>Once, a person with something to say could only print <b>essays</b>. I still write those. But the presses got stranger: now I also draw <b>comics</b> about ideas that deserve pictures, and — this is the new part — I publish <b>full working software</b>. Real tools, free to use, maintained the way a book stays in print — all of it built by me and my AI agent, Luo, on a spare MacBook Air.</p>
      <p>Everything here is <span class="truth">optimised for truth, not engagement</span>.</p>
      <a class="thesis-btn" href="/about/">Read the full thesis</a>
    </div>
  </div>
</section>

<%# ============ LATEST WRITING ============ %>
<section id="press">
  <div class="doodle doodle-press" aria-hidden="true">
    <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M68 8 l17 15 -33 38 c-3 3 -8 4 -10 1 c-2 -3 -1 -7 2 -10 z"/>
      <path d="M60 39 c2 2 4 3 7 3"/>
      <path d="M50 66 c-2 4 -5 7 -9 8"/>
      <path d="M6 90 c8 -7 13 3 21 -2 c7 -4 12 -1 19 -4 c5 -2 9 -1 12 0"/>
    </svg>
  </div>
  <div class="wrap">
    <div class="sec-label rise">The writing</div>
    <h2 class="rise">Fresh off the press.</h2>
    <div class="press-list rise">
      <% @posts.first(3).each_with_index do |post, i| %>
        <article class="press-item">
          <div class="doodle-mini press-mini press-mini-<%= i %>" aria-hidden="true">
            <% if i == 0 %>
              <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 36 h42 l-4 28 c-1 6 -9 8 -17 8 c-8 0 -16 -2 -17 -8 z"/>
                <path d="M64 42 c8 -2 12 2 10 8 c-2 5 -7 6 -12 5"/>
                <path d="M34 26 c0 -4 4 -4 4 -9"/>
                <path d="M48 26 c0 -4 4 -4 4 -9"/>
              </svg>
            <% elsif i == 1 %>
              <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M38 74 l-1 -42 c0 -13 21 -13 21 1 l0 33 c0 8 -13 8 -13 0 l0 -28"/>
              </svg>
            <% else %>
              <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M50 24 l0 18"/><path d="M50 58 l1 18"/>
                <path d="M24 50 l18 0"/><path d="M58 50 l18 1"/>
                <path d="M32 32 l13 13"/><path d="M55 55 l13 13"/>
                <path d="M68 32 l-13 13"/><path d="M45 55 l-14 14"/>
              </svg>
            <% end %>
          </div>
          <% if post.published_at %>
            <time class="press-date mono" datetime="<%= post.published_at.strftime("%Y-%m-%d") %>"><%= post.published_at.strftime("%b %-d, %Y") %></time>
          <% end %>
          <div class="press-body">
            <h3 class="press-title"><%= link_to post.title, public_post_path(post) %></h3>
            <% if post.excerpt.present? %>
              <p class="press-excerpt"><%= post.excerpt %></p>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  </div>
</section>

<%# ============ THE MACHINES ============ %>
<section id="apps">
  <div class="doodle doodle-apps" aria-hidden="true">
    <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M17 10 c-1 7 2 11 8 13 l46 48 c3 3 8 3 11 0 c3 -3 3 -8 0 -11 L34 13 c-2 -6 -7 -9 -13 -8 l7 8 -3 6 -6 2 z"/>
      <path d="M83 14 l-14 13 -6 -1 -38 40"/>
      <path d="M85 16 c3 3 2 6 -1 9 l-13 10"/>
      <path d="M23 68 c-3 5 -8 6 -11 11 c-2 4 1 8 5 7 c5 -1 6 -7 11 -10"/>
    </svg>
  </div>
  <div class="wrap">
    <div class="sec-label rise">The software</div>
    <h2 class="rise">Software I&rsquo;m building these days.</h2>
    <p class="sec-lede rise">I build a tonne of software with AI. Here it all is, in order of when I last shipped a commit to each one&rsquo;s main branch. (Yes, my AI employee updates this every day and reshuffles it from the latest data.)</p>

    <div class="machines">
      <% @machines.each do |machine| %>
        <article class="machine rise">
          <a class="machine-shot" href="<%= machine.url %>">
            <%= image_tag "machines/#{machine.slug}.jpg", alt: "The top of #{machine.name}'s landing page" %>
          </a>
          <h3 class="machine-title"><a href="<%= machine.url %>"><%= machine.name %></a></h3>
          <p class="machine-blurb"><%= machine.blurb %></p>
          <div class="machine-shipped">Launched <%= machine.launched_on.strftime("%-d %b %Y") %> · Last updated <%= machine.updated_on.strftime("%-d %b %Y") %></div>
        </article>
      <% end %>
    </div>
  </div>
</section>

<%# ============ LIBRARY ============ %>
<section id="library">
  <div class="doodle doodle-library" aria-hidden="true">
    <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M50 32 c-8 -6 -19 -8 -29 -6 l-2 39 c10 -2 21 0 30 6"/>
      <path d="M50 32 c8 -6 19 -8 29 -6 l2 39 c-10 -2 -21 0 -30 6"/>
      <path d="M50 32 l-1 39"/>
      <path d="M27 37 c6 -1 13 0 19 2"/>
      <path d="M27 45 c6 -1 13 0 19 2"/>
      <path d="M55 39 c6 -2 12 -3 18 -2"/>
      <path d="M64 28 l1 -15 6 5 5 -7 1 14"/>
    </svg>
  </div>
  <div class="wrap">
    <div class="sec-label rise">Archive</div>
    <p class="sec-lede rise">Articles I wrote in my past life.</p>

    <div class="shelf-scene rise">
      <div class="shelf-books">
        <% @eras.each do |era| %>
          <% style = era_style(era) %>
          <a class="book <%= style[:book] %>" href="<%= public_tag_path(era) %>">
            <% if style[:ribbon] %><span class="ribbon"></span><% end %>
            <span class="bands"></span>
            <span class="spine-title"><%= era.name %></span>
            <span class="count"><%= era.published_article_count %></span>
          </a>
        <% end %>
        <div class="plant"><span class="leaf"></span><span class="leaf"></span><span class="leaf"></span><span class="pot"></span></div>
      </div>
      <div class="shelf-board"></div>
    </div>
  </div>
</section>
<%# ============ SUBSCRIBE ============ %>
<section id="subscribe">
  <div class="doodle doodle-subscribe" aria-hidden="true">
    <svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14 52 l74 -30 -34 52 -8 -20 z"/>
      <path d="M46 54 l42 -32"/>
      <path d="M46 54 l-2 16 8 -12"/>
      <path d="M8 92 c16 5 30 0 36 -14" stroke-dasharray="1 8"/>
    </svg>
  </div>
  <div class="wrap">
    <div class="letter rise">
      <span class="stamp"><span class="stamp-inner" style="background:#fbf2df"><span style="font-family:var(--serif);font-style:italic;font-size:20px;color:#b05c34">N</span><span class="mono" style="color:#96491f">First class</span></span></span>
      <h2>Get the next shipment.</h2>
      <p>Not a newsletter. When I finish something, I send it to you: <b>a polished app you can use that day</b>, a fun comic, and the articles on how it all got made.</p>
      <p style="margin-top:14px"><b>No cadence. I ship when I ship.</b> Lately, I ship often.</p>
      <% if flash[:notice].present? %>
        <%# HTML fallback for a JS-less signup — Turbo handles the happy path in-place. %>
        <div id="subscribe_form">
          <p class="sub-confirm"><%= flash[:notice] %></p>
          <div class="sub-fine">One shipment at a time · unsubscribe anytime</div>
        </div>
      <% else %>
        <% if flash[:alert].present? %><p class="sub-fine sub-error"><%= flash[:alert] %></p><% end %>
        <%= render "subscribers/form" %>
      <% end %>
    </div>
  </div>
</section>
