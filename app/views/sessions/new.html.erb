<% content_for :title, "Sign in" %>

<div class="auth">
  <div class="auth__card">
    <h1>Sign in</h1>
    <p class="auth__sub">The writing desk is behind this door.</p>

    <% if alert = flash[:alert] %>
      <p class="auth__error"><%= alert %></p>
    <% end %>

    <%= form_with url: session_path, method: :post, class: "stacked-form" do |form| %>
      <div class="field">
        <%= form.label :email_address, "Email" %>
        <%= form.email_field :email_address, autofocus: true, autocomplete: "username" %>
      </div>
      <div class="field">
        <%= form.label :password, "Password" %>
        <%= form.password_field :password, autocomplete: "current-password" %>
      </div>
      <%= form.submit "Sign in", class: "w-btn w-btn--primary w-btn--block" %>
    <% end %>
  </div>
</div>
